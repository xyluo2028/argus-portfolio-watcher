# Copy to .env (chmod 600) and fill in. Never commit .env. See docs/deployment.md.

# --- data providers ---
# Live quotes, metrics, events, symbol search. Free tier is fine: https://finnhub.io
FINNHUB_API_KEY=
# SEC EDGAR requires a descriptive User-Agent, e.g. "argus you@example.com" (for `argus financials`)
SEC_USER_AGENT=
# Optional: raises OpenFIGI's rate limit when mapping non-US tickers
OPENFIGI_API_KEY=

# --- server ---
# Web UI / API / MCP-over-HTTP port (default 8787)
ARGUS_PORT=
# Listen address (default 127.0.0.1). Anything else requires ARGUS_TOKEN.
ARGUS_HOST=
# Hostnames to answer besides localhost, comma-separated: your tunnel's name,
# e.g. argus.tail1234.ts.net or argus.example.com
ARGUS_ALLOWED_HOSTS=
# Shared secret for the web UI, API and MCP. Set it whenever Argus is reachable from other
# machines. Generate: openssl rand -hex 32
ARGUS_TOKEN=

# --- data ---
# Database, caches, snapshots and backups (default ./data)
ARGUS_DATA_DIR=
# Backup sets kept by `argus backup` (default 14)
ARGUS_BACKUP_KEEP=
# Live WebSocket prices (default on). Set off for a second instance sharing the Finnhub key:
# Finnhub allows one stream per key, so two would keep knocking each other off.
ARGUS_STREAM=
